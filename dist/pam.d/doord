#%PAM-1.0
# PAM service for door's privileged daemon (doord). Installed to
# /etc/pam.d/doord. Mirrors the distro's local-login policy (as greetd does), so
# door authenticates users by exactly the same rules as a console login —
# door owns the conversation, not the policy.
#
# If this file is absent, libpam falls back to /etc/pam.d/other, which denies.

auth       requisite    pam_nologin.so
auth       include      system-local-login
account    include      system-local-login
session    include      system-local-login
password   include      system-local-login
