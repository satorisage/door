[Unit]
Description=door — privileged login daemon (doord)
Documentation=https://github.com/satorisage/door
# doord is the trusted core: it owns PAM, logind/seat/VT, and session spawn, and
# serves the local socket the unprivileged greeter connects to. It holds no UI.
# It also owns the greeter lifecycle (D-0008): it launches the greeter on its VT,
# so the getty on that VT must not run.
After=systemd-user-sessions.service systemd-logind.service getty@tty1.service display-manager.service
Wants=systemd-logind.service
# doord owns the greeter's seat/VT and the DRM master on it. It must not run
# alongside another login manager (two compositors would fight for DRM master on
# the same GPU) or tty1's getty. Conflicting display-manager.service means
# enabling doord stops the previous DM; After= orders that stop before doord.
Conflicts=getty@tty1.service display-manager.service
# Fail safe at the process level: doord already self-stops a crash-looping
# greeter (it exits cleanly, which does not respawn), but if doord *itself* dies
# repeatedly, land in `failed` rather than respawn forever — a wedged login
# manager must never thrash the GPU/console.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/doord
# /run/doord (root:root 0700) holds the socket; doord locks down door.sock to
# 0660 root:<greeter group> itself.
RuntimeDirectory=doord
RuntimeDirectoryMode=0700
# The greeter is named, not a numeric uid (doord resolves it). Seat/VT are door's.
Environment=DOORD_GREETER_USER=door-greeter
Environment=DOORD_SEAT=seat0
Environment=DOORD_VTNR=1
# DOORD_SOCKET defaults to /run/doord/door.sock; DOORD_PAM_SERVICE to "doord".
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical.target
