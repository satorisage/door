[Unit]
Description=door — privileged login daemon (doord)
Documentation=https://github.com/satorisage/door
# doord is the trusted core: it owns PAM, logind/seat/VT, and session spawn, and
# serves the local socket the unprivileged greeter connects to. It holds no UI.
# It also owns the greeter lifecycle (D-0008): it launches the greeter on its VT,
# so the getty on that VT must not run.
After=systemd-user-sessions.service systemd-logind.service getty@tty1.service display-manager.service
Wants=systemd-logind.service
# doord owns the greeter's seat/VT and the DRM master on it. It must not run
# alongside another login manager (two compositors would fight for DRM master on
# the same GPU) or tty1's getty. Conflicting display-manager.service means
# enabling doord stops the previous DM; After= orders that stop before doord.
Conflicts=getty@tty1.service display-manager.service
# Fail safe at the process level: doord already self-stops a crash-looping
# greeter (it exits cleanly, which does not respawn), but if doord *itself* dies
# repeatedly, land in `failed` rather than respawn forever — a wedged login
# manager must never thrash the GPU/console.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/doord
# /run/doord (root:root 0700) holds the greeter socket; doord locks down door.sock
# to 0660 root:<greeter group> itself. /run/doord-reauth holds the session-lock
# reauth socket; pre-creating it here guarantees it exists before doord seeds it into
# the Landlock ruleset (a missing dir would fail the whole ruleset install and silently
# un-sandbox the supervisor). doord widens it to 0755 and sets the socket to 0666
# itself — the reauth socket is reachable by any local session user (the peer-cred uid,
# not the socket mode, is the authorization gate), unlike the greeter-group-only socket.
RuntimeDirectory=doord doord-reauth
RuntimeDirectoryMode=0700
# The greeter is named, not a numeric uid (doord resolves it). Seat/VT are door's.
Environment=DOORD_GREETER_USER=door-greeter
Environment=DOORD_SEAT=seat0
Environment=DOORD_VTNR=1
# Spawn each per-login worker from a pre-forked helper that lives OUTSIDE doord's
# own sandboxed lineage, instead of forking it inline. This is what lets the
# Tier 3/4 sandboxing directives (see below) apply to doord without also caging
# the user's desktop session. The full login → clean-logout → reap → recycle →
# re-login cycle is validated on hardware; unset this to fall back to the legacy
# in-lineage spawn if a regression appears.
Environment=DOORD_SPAWNER=1
# Confine the supervisor's own syscall surface (Tier 3 seccomp). Safe to enforce
# only because DOORD_SPAWNER=1 moved session/greeter spawn off this lineage — the
# filter is inherited across fork + preserved across execve, so on the legacy
# in-lineage path it would confine the user's desktop and break every login (doord
# skips it there). `enforce` fails an unlisted syscall with EPERM (a debuggable
# local failure, not a killed supervisor); the empirically-derived allowlist was
# validated clean under SCMP_ACT_LOG across a full login → logout → recycle →
# re-login cycle on hardware before this flip. Reversible: unset for no
# filter, DOORD_SECCOMP=log to re-observe, DOORD_NO_SANDBOX=1 to force off for
# lockout recovery.
Environment=DOORD_SECCOMP=enforce
# Confine the supervisor's own filesystem surface (Tier 4 Landlock). Like the
# seccomp filter, a Landlock ruleset is inherited across fork + preserved across
# execve, so this is safe to enforce only because DOORD_SPAWNER=1 moved
# session/greeter spawn off this lineage (doord skips it on the legacy path). The
# ruleset grants read/exec on /usr /etc /proc /sys /run and read/write on
# /run/doord and /dev, denying everything else — most sharply /home, /root, /var,
# /tmp, /boot. Landlock has NO permissive/log mode, so unlike seccomp this was
# validated by an enumerate-then-enforce genny boot: DOORD_LANDLOCK=enforce ran a
# full login -> logout -> recycle -> re-login cycle clean with the shipped path
# seed before this flip. A too-tight seed is a debuggable, recoverable login
# failure (EACCES), not a killed supervisor. Reversible: unset for no ruleset, or
# DOORD_NO_SANDBOX=1 to force off for lockout recovery from a TTY.
Environment=DOORD_LANDLOCK=enforce
# DOORD_SOCKET defaults to /run/doord/door.sock; DOORD_PAM_SERVICE to "doord".
Restart=on-failure
RestartSec=2

# ── Sandboxing, Tier 1 (M5). ────────────────────────────────────────────────
#
# THE CONSTRAINT that shapes everything here: doord forks the per-login worker,
# which execve()s the user's *session/compositor* — all in doord's own process
# lineage and mount namespace (no unshare). seccomp filters and Landlock rules
# are inherited across fork and preserved across execve, so ANY restriction here
# is also imposed on the user's desktop. That makes the high-value directives
# UNSAFE until the session is spawned by a separate, pre-forked helper outside
# doord's sandbox (a planned refactor: a supervisor that sandboxes itself and
# hands session-spawn to an un-sandboxed helper). Concretely, DO NOT add:
#   RestrictAddressFamilies=  — would strip the user's session of AF_INET (no net)
#   SystemCallFilter=         — Tier 3; would kill session syscalls
#   SystemCallArchitectures=  — would kill 32-bit session apps (Steam/wine)
#   MemoryDenyWriteExecute=   — would break session JIT (browsers, java, Electron)
#   RestrictRealtime=         — would break session pro-audio (pipewire/jack RT)
#   RestrictNamespaces=       — would break flatpak / sandboxed-browser userns
#   ProtectHome= / ProtectSystem=strict / PrivateTmp= — leak via the shared mount
#                               namespace: hide $HOME, make /usr read-only, etc.
#   ProtectProc= / ProcSubset= — would blind free_seat's /proc scan (and the session)
# Each of the above only becomes safe once Tier 2 moves session-spawn out of
# doord's sandboxed lineage. Until then, only directives that neither doord NOR a
# normal desktop ever exercise are set below.
#
# Belt-and-suspenders NO_NEW_PRIVS (doord also sets PR_SET_NO_NEW_PRIVS in code).
NoNewPrivileges=yes
# doord never sets the system clock, loads kernel modules, reads the kernel ring
# buffer, or changes the hostname — and neither does a user's desktop session
# (those go through separate root services: timedated, hostnamed, journald). So
# these are safe to deny even though the session inherits them.
ProtectClock=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectHostname=yes
# Drop only capabilities that a login daemon provably never needs (and that a
# post-privdrop unprivileged session never has anyway), keeping every capability
# doord *does* use — privdrop (SETUID/SETGID), free_seat (KILL, SYS_PTRACE for
# the cross-uid /proc scan), the VT ioctls (SYS_TTY_CONFIG), DRM/seat (SYS_ADMIN),
# socket ownership (CHOWN/FOWNER/DAC_*), and PAM (AUDIT_*). Using the "~" drop
# form (not an allow-list) so an unenumerated cap doord relies on is never
# stripped — a too-tight allow-list would silently break logins.
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_TIME CAP_SYS_BOOT CAP_WAKE_ALARM CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_LEASE CAP_SYS_PACCT CAP_BLOCK_SUSPEND CAP_NET_BIND_SERVICE

[Install]
WantedBy=graphical.target
